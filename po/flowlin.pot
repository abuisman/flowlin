#: data/eu.ronkatil.Flowlin.metainfo.xml:12
msgid ""
"Flowlin is a fast local image browser modelled on FlowVision. Pick a folder "
"in the tree, see its images as thumbnails, and step through them full size "
"with the arrow keys. Recursive mode shows every image below a folder in one "
"grid."
msgstr ""

#: data/eu.ronkatil.Flowlin.metainfo.xml:19
msgid "Grid, waterfall (masonry) and list layouts"
msgstr ""

#: data/eu.ronkatil.Flowlin.metainfo.xml:20
msgid "Full-size viewer with zoom, pan, slideshow and animated images"
msgstr ""

#: data/eu.ronkatil.Flowlin.metainfo.xml:21
msgid "Folder jumps with W/A/S/D keys and right-button mouse gestures"
msgstr ""

#: data/eu.ronkatil.Flowlin.metainfo.xml:22
msgid "Tabs, favourites, file management with undo"
msgstr ""

#: data/eu.ronkatil.Flowlin.metainfo.xml:23
msgid ""
"Private by design: no network access, no thumbnail files on disk, nothing "
"remembered about what you opened"
msgstr ""

#: data/eu.ronkatil.Flowlin.metainfo.xml:38
msgid "First release: browser, viewer, recursive mode."
msgstr ""
